# Copiar a deploy/.env (NUNCA va a git) y completar. Secretos: openssl rand -base64 48
# Ver docs/requerimientos/02-arquitectura.md → Configuración.

# ── Imágenes (publicadas por GitHub Actions en GHCR) ───────────────────────
IMAGE_REGISTRY=ghcr.io/fernandomartinez018
IMAGE_TAG=main                 # main | qa | sha-<commit> (para fijar o volver a una versión)

# ── Perfiles: en la EC2 activar caddy (HTTPS) ──────────────────────────────
COMPOSE_PROFILES=              # en la EC2: tls
PUBLIC_HOST=                   # en la EC2: <ip-con-guiones>.sslip.io (Elastic IP)

# ── Base de datos ──────────────────────────────────────────────────────────
POSTGRES_DB=tizon
POSTGRES_USER=tizon
POSTGRES_PASSWORD=

# ── API (Spring Boot) ──────────────────────────────────────────────────────
JWT_SECRET=                    # al menos 32 bytes
JWT_EXPIRATION_MS=86400000
ADMIN_USERNAME=                # ADMIN inicial: se crea en el primer arranque si no existe
ADMIN_PASSWORD=
ALERT_THRESHOLD_PCT=30
CORS_ALLOWED_ORIGINS=          # vacío: la app nativa no usa CORS
API_BIND=127.0.0.1             # 0.0.0.0 solo para probar con un celular en la LAN (plan B de P-03)
API_PORT=8080

# ── IA ─────────────────────────────────────────────────────────────────────
INTERNAL_API_TOKEN=            # secreto compartido API ↔ IA
IA_TIMEOUT_SECONDS=10
MODEL_FILE=modelo_tizon_4c.keras    # en deploy/models/, junto a model_meta.json
